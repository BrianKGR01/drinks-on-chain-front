# Sitios del ecosistema (sin dominio comprado aún: valores de desarrollo)
NEXT_PUBLIC_URL_LANDING=http://localhost:3001
# ERP y POS aún no desplegados: sin definir en producción, /acceso los muestra como "Disponible pronto"
NEXT_PUBLIC_URL_ERP=http://localhost:3002
NEXT_PUBLIC_URL_POS=http://localhost:3004
# Origen canónico del sitio (metadataBase, sitemap, robots). Sin definir: Vercel en producción, localhost:3000 en desarrollo.
# NEXT_PUBLIC_SITE_URL=https://drinks-on-chain-bodegas.vercel.app
# API del backend (variable de servidor, sin NEXT_PUBLIC_). El navegador llama a /api/v1/* de este sitio y
# src/proxy.ts la reescribe a ${API_ORIGIN}/v1/* (plan/03 §6, P-1). Sin definir: /lista-de-espera y /unirse muestran
# que el envío no está disponible. Las páginas la leen al compilar: cambiarla exige un nuevo despliegue.
# API_ORIGIN=http://localhost:4000
# Firma de la IP del cliente para el backend (O1-OPS-1): variable de servidor (nunca NEXT_PUBLIC_), el mismo valor
# que PROXY_SHARED_SECRET del backend del entorno. Sin definir: no se firma y el backend usa la IP de la conexión.
# PROXY_SHARED_SECRET=change-me
# Cloudflare Turnstile (captcha de /unirse). Sin definir: la clave de prueba pública de Cloudflare, que siempre valida
# (1x00000000000000000000AA); el backend de desarrollo debe usar la secreta de prueba correspondiente.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=change-me
# Solicitud de alta formal de /unirse (formulario con NIT y captcha + /unirse/verificar). Necesita el correo de
# verificación del backend, que aún no existe: sin definir (o distinto de 1), /unirse y el menú llevan a la lista de
# espera de bodegas (/lista-de-espera) y /unirse/verificar responde 404. Se lee al compilar.
# NEXT_PUBLIC_FLAG_WINERY_APPLICATION=1
